{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups"
  ],
"layer": "top",
"position": "top",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,
"spacing": 0,
"margin-left": 12,
"margin-right": 12,
"margin-top": 6,

"modules-left": [
	"idle_inhibitor",
	"temperature",
	"hyprland/workspaces#rw",
	"tray",
	],

"modules-center": [
	"clock#2",
	"group/notify",
	],

"modules-right": [
    "network",
	//"hyprland/window",
	"battery",
 	// "group/audio",
  "pulseaudio",
	"custom/power",
	],
}
